{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Playwright and TypeScript test suite for OrangeHRM Demo",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
